{
  "name": "gh-auth-switcher",
  "displayName": "GitHub Auth Switcher",
  "description": "Switch specific users to current active accounts",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.138.0"
  },
  "publisher": "floatingcat",
  "homepage": "https://github.com/chumniu/vsce-gh-auth-switcher",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chumniu/vsce-gh-auth-switcher.git"
  },
  "license": "MIT",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gh-auth-switcher",
          "title": "GitHub Auth Switcher",
          "icon": "$(account)"
        }
      ]
    },
    "views": {
      "github-user-switcher": [
        {
          "id": "ghUserTreeView",
          "name": "Accounts",
          "icon": "$(account)"
        }
      ]
    },
    "commands": [
      {
        "command": "github-user-switcher.switchUser",
        "title": "Switch GitHub User"
      },
      {
        "command": "github-user-switcher.refresh",
        "title": "Refresh Accounts",
        "icon": "$(refresh)"
      },
      {
        "command": "github-user-switcher.addAccount",
        "title": "Add GitHub Account",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "github-user-switcher.addAccount",
          "when": "view == ghUserTreeView",
          "group": "navigation@1"
        },
        {
          "command": "github-user-switcher.refresh",
          "when": "view == ghUserTreeView",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ghUserTreeView",
        "contents": "No GitHub accounts found or GitHub CLI is not configured.\n[Log In to GitHub](command:github-user-switcher.login)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}